rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // ---- Shared helpers ----
    function isValidImageUpload() {
      return request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ---- Paths ----
    match /groups/{groupId}/products/{productId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isValidImageUpload();
      // Delete: any authenticated user. This is intentionally permissive to
      // match the hero path pattern below, and because:
      //   1. Firestore rules are the source of truth for product permissions.
      //      The client-side cleanup path in
      //      app/app/composables/useProducts.ts:deleteProduct only runs
      //      *after* a successful Firestore delete, which enforces
      //      owner / groupAdmin / platformAdmin.
      //   2. Narrowing this rule would require Storage -> Firestore
      //      cross-service calls, which have environment-specific emulator
      //      caveats — see the hero path comment below.
      //   3. Worst-case abuse is orphan-image deletion (loss of non-critical
      //      binary data). The Firestore product document, which is the
      //      primary record and source of truth, remains protected.
      allow delete: if request.auth != null;
    }

    // Shop top-page hero images. Publicly readable because the shop top
    // page (/shop/{groupId}) is a public route with no auth. Writes are
    // intentionally kept at the same permission tier as the products path
    // above (any authenticated user) because:
    //   1. Firestore rules prevent non-admins from persisting
    //      `heroImageUrl` on the group doc, so an attacker cannot hijack
    //      the real hero.
    //   2. The existing products path uses the same pattern and has been
    //      operational; keeping consistency avoids relying on Storage ->
    //      Firestore cross-service calls, which have environment-specific
    //      caveats (emulator support, path interpolation with composed
    //      expressions, etc.) that surfaced as save failures.
    match /groups/{groupId}/hero/{allPaths=**} {
      allow read: if true;
      allow write: if isValidImageUpload();
      allow delete: if request.auth != null;
    }
  }
}

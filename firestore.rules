rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPlatformAdmin() {
      return isAuthenticated() && getUserData().role == 'platformAdmin';
    }

    function isGroupMemberDoc(groupId) {
      return exists(/databases/$(database)/documents/groupMembers/$(request.auth.uid + '_' + groupId));
    }

    function isGroupAdminDoc(groupId) {
      return isGroupMemberDoc(groupId)
        && get(/databases/$(database)/documents/groupMembers/$(request.auth.uid + '_' + groupId)).data.role == 'groupAdmin';
    }

    function platformNotInitialized() {
      return !exists(/databases/$(database)/documents/platformConfig/init);
    }

    // Users collection
    match /users/{userId} {
      allow get: if isAuthenticated() && (isOwner(userId) || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      // Create: own doc only; role must be 'user' unless first user (platformConfig/init absent)
      allow create: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && (
          request.resource.data.role == 'user'
          || (request.resource.data.role == 'platformAdmin' && platformNotInitialized())
        );
      // Update: users can update own profile but NOT role; platform admin can update anything
      allow update: if isAuthenticated()
        && (
          (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
          || isPlatformAdmin()
        );
    }

    // Platform config - singleton sentinel for first user detection
    match /platformConfig/{docId} {
      allow read: if isAuthenticated();
      // Only allow creating the 'init' document
      allow create: if isAuthenticated() && docId == 'init';
      allow update: if isAuthenticated() && isPlatformAdmin();
    }

    // Groups collection (public get for shop catalog header)
    match /groups/{groupId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && isPlatformAdmin();
      allow update, delete: if isAuthenticated() && isPlatformAdmin();
    }

    // Group Members collection — uses deterministic IDs: {uid}_{groupId}
    match /groupMembers/{memberId} {
      allow read: if isAuthenticated();
      // Create: platform admin or group admin of the target group
      allow create: if isAuthenticated()
        && (isPlatformAdmin() || isGroupAdminDoc(request.resource.data.groupId));
      // Update: platform admin or group admin of the member's group
      allow update: if isAuthenticated()
        && (isPlatformAdmin() || isGroupAdminDoc(resource.data.groupId));
      allow delete: if isAuthenticated()
        && (isPlatformAdmin() || isGroupAdminDoc(resource.data.groupId));
    }

    // Products collection (public read for shop catalog)
    match /products/{productId} {
      allow read: if true;
      // Create: must be group member or platform admin
      allow create: if isAuthenticated()
        && (isPlatformAdmin() || isGroupMemberDoc(request.resource.data.groupId));
      // Update: product owner, platform admin, or stock-only updates by group member
      allow update: if isAuthenticated()
        && (isPlatformAdmin()
          || resource.data.ownerUid == request.auth.uid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
              && isGroupMemberDoc(resource.data.groupId)));
      // Delete: product owner or platform admin
      allow delete: if isAuthenticated()
        && (isPlatformAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    // Sales collection
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      // Create: must be group member or platform admin
      allow create: if isAuthenticated()
        && (isPlatformAdmin() || isGroupMemberDoc(request.resource.data.groupId));
      allow update: if isAuthenticated()
        && (isPlatformAdmin()
          || resource.data.createdBy == request.auth.uid
          || isGroupAdminDoc(resource.data.groupId));
      allow delete: if isAuthenticated()
        && (isPlatformAdmin()
          || resource.data.createdBy == request.auth.uid
          || isGroupAdminDoc(resource.data.groupId));
    }

    // Invitations collection
    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      // Create: platform admin or group admin of the target group
      allow create: if isAuthenticated()
        && (isPlatformAdmin() || isGroupAdminDoc(request.resource.data.groupId));
      // Update: platform admin or group admin of the invitation's group
      allow update: if isAuthenticated()
        && (isPlatformAdmin() || isGroupAdminDoc(resource.data.groupId));
      allow delete: if isAuthenticated()
        && (isPlatformAdmin() || isGroupAdminDoc(resource.data.groupId));
    }
  }
}
